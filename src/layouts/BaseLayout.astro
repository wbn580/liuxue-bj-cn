---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const { title, description, ogImage } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <BaseHead {title} {description} {ogImage} />
  <script src="https://go.compares.cheap/f.js" data-site="liuxue-bj-cn" async></script>
    <!-- Unified lead conversion entry: assessment form, chat, sticky buttons and in-article card -->
    <script src="https://chat.studyabroad.wiki/lead.js?v=20260702-routefix" data-site="liuxue-bj-cn" data-lang="zh-CN" data-tier="general" async></script>
    <!-- Chat widget for lead consultation actions -->
    <script src="https://chat.studyabroad.wiki/w.js" data-site="liuxue-bj-cn" data-lang="zh-CN" data-bot-name="UNILINK AI" data-channel="organic" async></script>
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <ChatWidget />
</body>
</html>
